# xlab-yt settings. Everything is optional; uncomment a line to change it.

# Name and accent color (also used for the app icon)
# APP_TITLE=xlab-yt
# THEME_COLOR=#fa233b
# AMOLED_BG=false

# Playback
# DEFAULT_QUALITY=720
# MAX_QUALITY=2160
# AUTOPLAY=false
# AUTO_BG_PLAYBACK=true              # keep playing when you leave the app or lock the phone
# AUTOSKIP_SB_SEGMENTS=              # SponsorBlock, e.g. sponsor,selfpromo,intro,outro,interaction

# Browsing
# BROWSE_CACHE_TTL=600               # seconds to cache search / feed / channel pages

# Speed (fast path ported from xlab-player)
# FAST_PATH=true                     # resolve YouTube with the android_vr client first (no JS challenge solving), fall back automatically
# MAX_PREFETCH=1                     # videos resolved ahead of time at once, per worker (hover / touch / up next)
# SHORTS_PLAYER=youtube              # youtube = YouTube's own player in the browser (no ads in single Shorts, no server load); server = download MP4s here
# MAX_SHORT_PREFETCH=1               # Shorts downloaded ahead of time at once, per worker
# PREFETCH_VISIBLE=false             # also resolve every video that scrolls into view (needs a bigger server)
# WORKERS=2                          # server processes; each uses ~150-300 MB

# Accounts
# SHARE_SERVER_ACCOUNT=true          # people who haven't uploaded their own cookies.txt (Settings) use the server's cookies.txt; false = they're guests
# ACCOUNTS_PATH=./accounts           # where uploaded cookies are kept; mount /app/accounts as a volume so they survive updates

# Network
# POT_PROVIDER_URL=http://bgutil-provider:4416   # bgutil PO token container (see docker-compose.yml)
# STREAM_CHUNK_MB=10                 # size of each piece fetched from YouTube while streaming (0 = one big request)
# DNS_CACHE_TTL=300                  # seconds to cache DNS lookups inside the app (0 = off)
# PROXIES=local                      # proxies to try in order, e.g. local,http://10.0.0.5:8888
# COOKIES_ONLY_ON_FAILURE=true       # for playback, use cookies.txt only when a video fails

# Performance
# MAX_PROCESSES=5
# DISABLE_TRANSCODING=false
# MAX_VIDEO_AGE=3600                 # seconds before cached video files are removed
